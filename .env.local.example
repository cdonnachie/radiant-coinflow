# Avian Core RPC Configuration
# Copy this file to .env.local and fill in your values

# URL of your Avian Core node (include port, typically 7896 for mainnet)
AVIAN_RPC_URL=http://YOUR_PROXMOX_IP:7896

# RPC credentials from your avian.conf (rpcuser/rpcpassword)
AVIAN_RPC_USER=your_rpc_username
AVIAN_RPC_PASS=your_rpc_password

# Required node settings in avian.conf:
#   txindex=1
#   addressindex=1
#   spentindex=1
#   timestampindex=1
#   assetindex=1
#   rpcallowip=YOUR_NEXT_JS_SERVER_IP (or 0.0.0.0/0 if local-only)
