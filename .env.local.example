# Radiant CoinFlow — backend configuration
# Copy this file to .env.local and fill in your values.
#
# Three backends are supported; all answer the same RPC shapes:
#   rest      — RXinDexer REST API; paginated history with NO size ceiling, so
#               busy exchange/pool wallets that ElectrumX refuses still work
#   electrumx — any Radiant ElectrumX server (fast, but caps large histories)
#   rpc       — a radiantd build with address/spent index patches

# Backend selection: 'rest', 'electrumx', or 'rpc'. Optional — defaults to
# rest if RADIANT_REST_URL is set, else electrumx if RADIANT_ELECTRUM_HOST is
# set, else rpc.
RADIANT_BACKEND=rest

# --- RXinDexer REST backend ---
RADIANT_REST_URL=http://127.0.0.1:8000

# --- ElectrumX backend ---
RADIANT_ELECTRUM_HOST=127.0.0.1
# 50001/50010 are typically plain TCP, 50002 is TLS
RADIANT_ELECTRUM_PORT=50010
# Optional; defaults to true only for port 50002
RADIANT_ELECTRUM_TLS=false

# --- Native RPC backend ---
# URL of your radiantd node (default mainnet RPC port is 7332)
#RADIANT_RPC_URL=http://127.0.0.1:7332
# RPC credentials from your radiant.conf (rpcuser/rpcpassword)
#RADIANT_RPC_USER=your_rpc_username
#RADIANT_RPC_PASS=your_rpc_password

# Required radiant.conf settings for the rpc backend:
#   txindex=1
#   addressindex=1
#   spentindex=1
#   rpcallowip=YOUR_NEXT_JS_SERVER_IP (or 127.0.0.1 if local-only)
