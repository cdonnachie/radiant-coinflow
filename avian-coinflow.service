[Unit]
Description=CoinFlow Explorer — Avian Network
Documentation=https://github.com/AvianNetwork/avian-coinflow
After=network.target

[Service]
Type=simple
User=coinflow
Group=coinflow
WorkingDirectory=/opt/avian-coinflow

# Environment — edit these or point to a separate env file
Environment=NODE_ENV=production
Environment=PORT=3000
# EnvironmentFile=/opt/avian-coinflow/.env.local

# Credentials for the Avian Core RPC (uncomment EnvironmentFile above and
# put these in .env.local instead of here so they are not world-readable)
Environment=AVIAN_RPC_URL=http://127.0.0.1:7896
Environment=AVIAN_RPC_USER=rpcuser
Environment=AVIAN_RPC_PASS=rpcpassword

ExecStart=/usr/bin/node node_modules/.bin/next start --port 3000
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/avian-coinflow/.next/cache

[Install]
WantedBy=multi-user.target
